// ZUPA database schema (PostgreSQL via Prisma 6)
//
// Conventions
//  - Money is stored as INTEGER MINOR UNITS (NLe 12.50 -> 1250). Never floats.
//    The number of decimals for a currency lives in Currency.exponent.
//  - Orders snapshot product names/prices/addresses so history never changes
//    when the catalogue or a customer's address book is edited.
//  - Tables are snake_case plural via @@map; Prisma models stay PascalCase.
//  - Neon: DATABASE_URL = pooled connection (app), DIRECT_URL = direct (migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Fine-grained permissions per role are defined in code (src/lib/rbac.ts, Phase 4).
enum AdminRole {
  SUPER_ADMIN
  MANAGER
  INVENTORY
  SUPPORT
  DELIVERY_MANAGER
  FINANCE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockReason {
  INITIAL
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  RESERVED_RELEASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  MONIME
  CASH_ON_DELIVERY
  MANUAL
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionType {
  CHARGE
  REFUND
}

enum TransactionStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  DELIVERY_UPDATE
  PROMOTION
  SUPPORT
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

// ─────────────────────── Identity & access ───────────────────────

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?    @unique
  passwordHash     String
  name             String
  role             UserRole   @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customerProfile CustomerProfile?
  adminProfile    AdminProfile?
  deliveryProfile DeliveryPersonnel?
  sessions        Session[]
  addresses       DeliveryAddress[]
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  reviews         Review[]
  notifications   Notification[]
  tickets         SupportTicket[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  redemptions     PromotionRedemption[]

  @@index([role, status])
  @@map("users")
}

model CustomerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth     DateTime?
  preferredCurrency String @default("SLE")
  marketingOptIn  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("customer_profiles")
}

model AdminProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminRole  AdminRole @default(MANAGER)
  department String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("admin_profiles")
}

// Server-side sessions. Only a HASH of the cookie token is stored, so a database
// leak cannot be replayed as a login.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────── Catalogue ─────────────────────────

model Currency {
  code     String  @id // ISO 4217, e.g. "SLE" (new Leone), "USD"
  name     String
  symbol   String  // e.g. "NLe", "$"
  exponent Int     @default(2)
  active   Boolean @default(true)

  @@map("currencies")
}

model ProductCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@index([active, sortOrder])
  @@map("product_categories")
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  sku            String        @unique
  name           String
  description    String
  brand          String?
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceMinor     Int
  compareAtMinor Int?          // original price when discounted
  currencyCode   String        @default("SLE")
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images         ProductImage[]
  specifications ProductSpecification[]
  inventory      Inventory?
  stockMovements StockMovement[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([categoryId, status])
  @@index([status, featured])
  @@index([status, createdAt])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? // Cloudinary public id, used for deletion
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_specifications")
}

// One stock row per product. `reserved` is stock held by unpaid/unfulfilled orders.
model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  @@index([quantity])
  @@map("inventory")
}

// Append-only ledger: every stock change is explained and attributable.
model StockMovement {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    StockReason
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorId   String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([active, sortOrder])
  @@map("banners")
}

// ───────────────────────── Shopping ─────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int          // 1..5, enforced in the API layer
  title            String?
  body             String?
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

// ───────────────────── Delivery & addresses ─────────────────────

model DeliveryZone {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  regions          String[] // regions / districts / neighbourhoods covered
  feeMinor         Int
  freeOverMinor    Int?     // order subtotal above which delivery is free
  estimatedDaysMin Int      @default(1)
  estimatedDaysMax Int      @default(3)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  addresses DeliveryAddress[]
  orders    Order[]
  personnel DeliveryPersonnel[]

  @@map("delivery_zones")
}

model DeliveryAddress {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String        @default("Home")
  recipientName String
  phone         String
  region        String
  city          String
  area          String?
  addressLine   String
  landmark      String?
  zoneId        String?
  zone          DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([zoneId])
  @@map("delivery_addresses")
}

model DeliveryPersonnel {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String   @unique
  vehicle   String?
  active    Boolean  @default(true)
  zones     DeliveryZone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DeliveryAssignment[]

  @@map("delivery_personnel")
}

// One row per delivery ATTEMPT. A failed attempt keeps its row (with a reason);
// re-assigning creates attempt + 1.
model DeliveryAssignment {
  id                 String            @id @default(cuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  personnelId        String?
  personnel          DeliveryPersonnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  attempt            Int               @default(1)
  status             DeliveryStatus    @default(PENDING)
  assignedById       String?
  assignedAt         DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  failureReason      String?
  receivedByName     String?           // who accepted the parcel
  confirmationNote   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([orderId, attempt])
  @@index([personnelId, status])
  @@index([status])
  @@map("delivery_assignments")
}

// ─────────────────────── Orders & payments ───────────────────────

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // human-friendly, e.g. ZP-20261125-4F7K
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         OrderStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING) // denormalised from payments for fast filtering

  subtotalMinor    Int
  discountMinor    Int       @default(0)
  deliveryFeeMinor Int       @default(0)
  totalMinor       Int
  currencyCode     String    @default("SLE")

  promotionId    String?
  promotion      Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  zoneId         String?
  zone           DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // Address snapshot (copied at checkout; later address edits never alter history)
  recipientName  String
  recipientPhone String
  region         String
  city           String
  area           String?
  addressLine    String
  landmark       String?
  notes          String?

  // Prevents duplicate orders when a client retries the same checkout request.
  idempotencyKey String?    @unique

  placedAt       DateTime   @default(now())
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items          OrderItem[]
  payments       Payment[]
  history        OrderStatusHistory[]
  deliveries     DeliveryAssignment[]
  stockMovements StockMovement[]
  redemption     PromotionRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([zoneId])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameSnapshot      String
  skuSnapshot       String
  imageUrlSnapshot  String?
  unitPriceMinor    Int
  quantity          Int
  lineTotalMinor    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  amountMinor        Int
  currencyCode       String        @default("SLE")
  provider           String?       // e.g. "monime" once integrated
  providerReference  String?       @unique
  customerReference  String?       // reference the customer supplies for MANUAL payments
  note               String?
  verifiedById       String?
  verifiedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  transactions Transaction[]

  @@index([orderId])
  @@index([status, method])
  @@map("payments")
}

// Every attempt to move money. A payment is only PAID after a verified SUCCEEDED
// transaction. `idempotencyKey` makes duplicate processing impossible.
model Transaction {
  id                String            @id @default(cuid())
  paymentId         String
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type              TransactionType   @default(CHARGE)
  status            TransactionStatus @default(INITIATED)
  provider          String
  providerReference String?
  amountMinor       Int
  currencyCode      String            @default("SLE")
  idempotencyKey    String            @unique
  rawResponse       Json?
  failureReason     String?
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([paymentId])
  @@index([provider, providerReference])
  @@index([status, createdAt])
  @@map("transactions")
}

// Raw inbound provider notifications. (provider, eventId) is unique so a replayed
// webhook can never be processed twice.
model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

// ───────────────────────── Promotions ─────────────────────────

model Promotion {
  id               String        @id @default(cuid())
  code             String        @unique
  description      String?
  type             PromotionType
  percentOff       Int?          // for PERCENTAGE (1..100)
  amountOffMinor   Int?          // for FIXED_AMOUNT
  maxDiscountMinor Int?
  minOrderMinor    Int           @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perUserLimit     Int?
  usedCount        Int           @default(0)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orders      Order[]
  redemptions PromotionRedemption[]

  @@index([active, endsAt])
  @@map("promotions")
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([promotionId, userId])
  @@map("promotion_redemptions")
}

// ───────────────── Notifications, support, ops ─────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages SupportMessage[]

  @@index([userId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// Append-only record of who did what. Written for every admin mutation.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. "product.update", "payment.verify"
  entity    String   // e.g. "Product"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Key/value store for admin-editable settings (store name, base currency,
// support contacts, low-stock defaults...). Values are JSON.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}
