# Copy this file to ".env" and fill it in. NEVER share or commit ".env".
# Neon connection string: Neon dashboard -> your project -> Connect -> copy the "pooled" string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=3001

# Email for password-reset codes (optional). Fill in ONE provider; leave the rest empty.
# Without these, codes are only printed in the server log.
MAIL_FROM=ZUPA <orders@yourdomain.com>
RESEND_API_KEY=
BREVO_API_KEY=
